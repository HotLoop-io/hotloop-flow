        "kind": "error",
        "style": "plain"
    },
    {
        "id": "trend",
        "type": "dia-chart",
        "z": "scale-body",
        "x": 880,
        "y": 440,
        "wires": [],
        "label": "Trend",
        "mode": "chart",
        "history": 1024,
        "unit": "kg"
    },
    {
        "id": "stopctl",
        "type": "dia-control",
        "z": "scale-body",
        "x": 600,
        "y": 520,
        "wires": [
            [
                "stop"
            ],
            []
        ],
        "label": "Stop",
        "kind": "bool",
        "style": "switch",
        "default": "false",
        "ew_in": [
            [
                "value"
            ],
            []
        ]
    },
    {
        "id": "stop",
        "type": "dia-body-out",
        "z": "scale-body",
        "x": 880,
        "y": 640,
        "wires": [],
        "name": "stop"
    },
    {
        "id": "windowOut",
        "type": "dia-body-out",
        "z": "scale-body",
        "x": 1140,
        "y": 660,
        "wires": [],
