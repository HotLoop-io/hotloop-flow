        "kind": "number",
        "style": "big",
        "unit": "kg",
        "digits": 2
    },
    {
        "id": "unit",
        "type": "dia-indicator",
        "z": "scale-body",
        "x": 1140,
        "y": 500,
        "wires": [],
        "label": "Unit",
        "kind": "string",
        "style": "plain"
    },
    {
        "id": "led",
        "type": "dia-indicator",
        "z": "scale-body",
        "x": 1140,
        "y": 580,
        "wires": [],
