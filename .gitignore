# Build output
/hotloop-flow
/hotloop-flow.exe
/dist/
/.deploy/

# Editor bundle build artefacts (generated into web/dist by esbuild, embedded at build time)
/web/dist/*
# ...except the placeholder. web/embed.go has //go:embed all:dist, which is a
# compile error when the directory does not exist — so a fresh clone could not
# run go build, go vet or go test at all until the editor had been built. The
# comment in embed.go always claimed this file existed; the ignore rule above
# meant it never could.
!/web/dist/.gitkeep
/web/node_modules/
/web/e2e/node_modules/
/web/e2e/test-results/
/web/e2e/playwright-report/

# Runtime data — never commit a flow file or a credential store
/data/
*.db
*.bolt
flows.json
flows.json.bak*
credentials.json

# Helm packaging output
*.tgz

# Go
*.test
*.out
coverage.*

# OS
.DS_Store
Thumbs.db

# The published JSONata test suite, cloned by CI at a pinned tag, not committed
testdata/jsonata-suite/

# Compiled WASM test guest — built by CI, not committed
testdata/wasmguest/*.wasm
testdata/wasmguest/*.h
