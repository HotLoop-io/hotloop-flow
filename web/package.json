{
  "name": "hotloop-flow-editor",
  "version": "0.1.0",
  "private": true,
  "description": "The HotLoop Flow editor: Astro with Svelte islands, built to static files and embedded in the binary.",
  "type": "module",
  "scripts": {
    "build": "astro build && node postbuild.mjs",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --compiler-warnings \"a11y_label_has_associated_control:ignore,state_referenced_locally:ignore\"",
    "dev": "astro dev"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/svelte": "9.1.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "^24.19.2",
    "astro": "7.4.2",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "6.0.3"
  }
}
