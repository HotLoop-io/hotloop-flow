  {
    "id": "f1",
    "type": "function",
    "z": "press",
    "name": "read oven 3",
    "func": "// The oven's last eight readings, in the order the thermocouple gave them.\nconst readings = [197, 201, 204, 208, 203, 199, 207, 202];\nconst n = context.get('n') || 0;\ncontext.set('n', n + 1);\nmsg.payload = readings[n % readings.length];\nmsg.topic = 'oven3/temp';\nreturn msg;",
    "outputs": 1,
    "x": 330,
    "y": 120,
    "wires": [
      [
        "r1"
      ]
    ]
  },
  {
    "id": "r1",
    "type": "range",
    "z": "press",
    "name": "to deg C",
    "property": "payload",
    "minin": 0,
    "maxin": 400,
    "minout": 0,
    "maxout": 400,
    "action": "scale",
    "round": true,
    "x": 520,
    "y": 120,
    "wires": [
      [
        "s1"
      ]
    ]
  },
  {
    "id": "s1",
    "type": "switch",
    "z": "press",
    "name": "over 205?",
    "property": "payload",
    "propertyType": "msg",
    "outputs": 2,
    "checkall": "true",
    "rules": [
      {
        "t": "gt",
        "v": "205",
        "vt": "num"
      },
